# Copy to .env and adjust as needed
DATABASE_URL=sqlite:///./data/url_shortener.db
BASE_URL=http://localhost:8000
CODE_LENGTH=7
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_REDIRECT_PER_MINUTE=120
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=5000
DEDUP_EXISTING_URLS=true

# Only used by docker-compose.yml (Postgres container) - set your own values in .env,
# never commit real credentials.
POSTGRES_USER=shortener
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shortener
